# Copy values to Netlify's production context; never commit the completed file.
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
AIVEN_PG_URL=
AIVEN_PG_CA_CERT=

VITE_SOLANA_CLUSTER=mainnet-beta
# SOLANA_RPC is private. Browser HTTP RPC uses the same-origin /rpc proxy.
SOLANA_RPC=
VITE_SOLANA_WSS=
TREASURY_SECRET_KEY=
# Never define VITE_TREASURY_SECRET_KEY or VITE_TREASURY_PRIVATE_KEY.

MP_ENVIRONMENT=production
MP_ACCESS_TOKEN=
MP_USER_ID=
MP_EXTERNAL_POS_ID=
# Required for automatic per-merchant POS creation. MP_EXTERNAL_POS_ID is legacy only.
MP_STORE_ID=
MP_WEBHOOK_SECRET=
CONVERSION_FEE_BPS=50
ETH_RPC_URL=
# Required: set to the verified heartbeat/freshness policy for the existing USD / ARS feed.
# Published heartbeat is 86400 seconds (verified 2026-10-14). Choosing 86400
# accepts rounds up to 24 hours old; keep blank until that business policy is accepted.
CHAINLINK_MAX_AGE_SECONDS=
PAYMENTS_BASE_URL=https://YOUR-SITE.netlify.app
INTERNAL_WORKER_SECRET=
PAYMENTS_ENABLED=false
PAYMENTS_ADMIN_USER_IDS=
# Optional: authenticated Privy DID used by the local read-only preflight.
PAYMENTS_CHECK_USER_ID=
