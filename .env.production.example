# Copy values to Netlify's production context; never commit the completed file.
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
AIVEN_PG_URL=
AIVEN_PG_CA_CERT=

VITE_ARC_NETWORK=mainnet
# ARC_RPC is private (server-side). Browser reads use the same-origin /rpc proxy.
ARC_RPC=https://rpc.mainnet.arc.io
# Optional public RPC for the Privy embedded wallet. Empty uses rpc.mainnet.arc.io.
VITE_ARC_RPC=
# Treasury EVM private key (0x + 64 hex). Server-side only; it pays payout gas in USDC.
TREASURY_SECRET_KEY=

MP_ENVIRONMENT=production
MP_ACCESS_TOKEN=, vi
MP_USER_ID=
MP_EXTERNAL_POS_ID=
MP_WEBHOOK_SECRET=
CONVERSION_FEE_BPS=50
ETH_RPC_URL=
# Required. Maximum Chainlink USD/ARS quote age in seconds; older quotes reject the charge.
# 90000 = 25 hours (published heartbeat of 86400 s + 1 h margin).
CHAINLINK_MAX_AGE_SECONDS=90000
PAYMENTS_BASE_URL=https://YOUR-SITE.netlify.app
INTERNAL_WORKER_SECRET=
PAYMENTS_ENABLED=false
PAYMENTS_ADMIN_USER_IDS=

# USDC transfers (the user pays the Arc network fee in USDC): enable after wallet validation.
TRANSFERS_ENABLED=false
# Optional production pilot: exact Privy user IDs, comma-separated. Empty denies all while disabled.
TRANSFERS_ALLOWED_USER_IDS=

# Invoice cession pilot (docs/factoring/PLAN_IMPLEMENTACION_PILOTO.md section 10).
# Server-side only: never prefix with VITE_. The UI reads GET /invoices/access.
# Opens the pilot to every user. Keep false and use the allowlist.
FACTORING_ENABLED=false
# Exact Privy user IDs, comma-separated, while disabled. Empty denies all.
FACTORING_ALLOWED_USER_IDS=
# Manual-review admins (separate from PAYMENTS_ADMIN_USER_IDS).
FACTORING_ADMIN_USER_IDS=
# disabled (take and pay return 503), simulated (no real money) or live (21 Millions).
FACTORING_PAYMENTS_MODE=disabled
# Discount rate (annual, 365-day base) and MidatoPay fee on the discount, in basis points.
FACTORING_RATE_BPS=3500
FACTORING_FEE_BPS=250
# Tacit acceptance window from issue (days) and offer lifetime (hours).
FACTORING_ACCEPTANCE_DAYS=21
FACTORING_OFFER_HOURS=72
# Nominal cap in cents. Required in live (D-08; 1000000 = ARS 10,000).
FACTORING_MAX_NOMINAL_CENTS=
# MidatoPay 22-digit CVU for the fee. Required in simulated and live.
FACTORING_FEE_CVU=
# SHA-256 (64 hex) of the signed framework agreement. Required to send invoices.
FACTORING_FRAMEWORK_SHA256=
# staging (nx_test_ key) or production (nx_live_ key).
TWENTYONE_ENVIRONMENT=staging
# Secret: 21 Millions machine credential. Netlify only, never VITE_.
TWENTYONE_SECRET_KEY=
# Secret: 21 Millions webhook whsec_ secret (optional).
TWENTYONE_WEBHOOK_SECRET=
# On-chain registry. true only with live + production (D-16). Off in the MVP.
FACTORING_NFT_ENABLED=false
FACTORING_REGISTRY_ADDRESS=
# Secret: registry EVM key, distinct from TREASURY_SECRET_KEY.
FACTORING_REGISTRY_SECRET_KEY=
# ARCA WSCDC check (optional, not implemented in the MVP).
FACTORING_ARCA_CHECK=false
