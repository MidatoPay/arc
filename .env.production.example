# Copy values to Netlify's production context; never commit the completed file.
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
AIVEN_PG_URL=
AIVEN_PG_CA_CERT=

VITE_ARC_NETWORK=mainnet
# ARC_RPC is private (server-side). Browser reads use the same-origin /rpc proxy.
ARC_RPC=https://rpc.mainnet.arc.io
# Optional public RPC for the Privy embedded wallet. Empty uses rpc.mainnet.arc.io.
VITE_ARC_RPC=
# Treasury EVM private key (0x + 64 hex). Server-side only; it pays payout gas in USDC.
TREASURY_SECRET_KEY=

MP_ENVIRONMENT=production
MP_ACCESS_TOKEN=, vi
MP_USER_ID=
MP_EXTERNAL_POS_ID=
MP_WEBHOOK_SECRET=
CONVERSION_FEE_BPS=50
ETH_RPC_URL=
# Required. Maximum Chainlink USD/ARS quote age in seconds; older quotes reject the charge.
# 90000 = 25 hours (published heartbeat of 86400 s + 1 h margin).
CHAINLINK_MAX_AGE_SECONDS=90000
PAYMENTS_BASE_URL=https://YOUR-SITE.netlify.app
INTERNAL_WORKER_SECRET=
PAYMENTS_ENABLED=false
PAYMENTS_ADMIN_USER_IDS=

# USDC transfers (the user pays the Arc network fee in USDC): enable after wallet validation.
TRANSFERS_ENABLED=false
# Optional production pilot: exact Privy user IDs, comma-separated. Empty denies all while disabled.
TRANSFERS_ALLOWED_USER_IDS=
