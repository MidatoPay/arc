# Key de Anthropic para el agente de voz — https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-...

# RPC de Arc Testnet. Dejalo vacío para usar el público (limita consultas)
# o pegá tu URL gratuita de Alchemy: https://arc-testnet.g.alchemy.com/v2/TU_CLAVE
VITE_ARC_RPC=

# RPC de Ethereum Mainnet para leer el Price Feed Chainlink USD/ARS.
# Dejalo vacío para usar ethereum.publicnode.com
VITE_ETH_RPC=

# Wallet recaudadora (tesorería) en Arc Testnet — privada, SOLO testnet.
# Debe tener USDC del faucet. Se usa para Cobrar y Convertir ARS→USDC.
# Nunca uses una clave con fondos reales. Queda expuesta al browser (demo).
VITE_TREASURY_PRIVATE_KEY=

# SOLO para demo local — nunca subas el .env a git ni deploys públicos.

