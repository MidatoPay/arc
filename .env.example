# Privy App ID (público — va al browser). Dashboard → App settings.
# Habilitá embedded wallets EVM (Ethereum) en el dashboard de Privy.
VITE_PRIVY_APP_ID=

# Key de Anthropic para el agente de voz — https://console.anthropic.com
# Server-side only (Netlify Function /parse-intent). SIN prefijo VITE_.
ANTHROPIC_API_KEY=sk-ant-...

# Red: Arc Mainnet (chain ID 5042). Único valor soportado: mainnet.
VITE_ARC_NETWORK=mainnet

# RPC HTTPS público de Arc que usa la wallet embebida de Privy en el browser.
# Dejalo vacío para usar https://rpc.mainnet.arc.io. Nunca pongas acá una URL con API key.
VITE_ARC_RPC=

# RPC de Ethereum Mainnet para leer el Price Feed Chainlink USD/ARS.
# Dejalo vacío para usar ethereum.publicnode.com
VITE_ETH_RPC=

# Wallet recaudadora (tesorería) en Arc — clave privada EVM (0x + 64 hex).
# Paga en USDC el monto y el gas de cada payout de Mercado Pago.
# Server-side only (Netlify Functions). SIN prefijo VITE_. Nunca la subas a git.
TREASURY_SECRET_KEY=

# Agenda de contactos — Postgres en Aiven. Server-side only, SIN prefijo
# VITE_ (si llevara ese prefijo, Vite lo mete en el bundle del browser).
# Ver docs/superpowers/specs/2026-08-05-contacts-agenda-design.md § 1.5.
AIVEN_PG_URL=postgres://user:pass@host:port/defaultdb
# CA certificate de Aiven (dashboard del servicio → "CA Certificate" → Download).
# Pegalo en UNA sola línea con los saltos de línea como \n literales (entre
# comillas dobles) — dotenv no soporta multilínea sin comillas, y el código
# en netlify/functions/contacts.js hace .replace(/\\n/g, "\n") al leerlo.
AIVEN_PG_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# App Secret de Privy (dashboard → App settings → API keys) — distinto de
# VITE_PRIVY_APP_ID (esa es pública). Se usa para verificar el access token
# del usuario server-side antes de tocar la DB o la recaudadora.
PRIVY_APP_SECRET=

# SOLO para demo local — nunca subas el .env a git ni deploys públicos.

# Cobros Mercado Pago. Ejecutar npm run payments:env para agregar faltantes
# al .env privado y generar INTERNAL_WORKER_SECRET sin imprimirlo.
# En Arc Mainnet solo se admite production: un pago de sandbox no puede liberar USDC real.
# Mantené PAYMENTS_ENABLED=false hasta completar la configuración.
MP_ENVIRONMENT=production
MP_ACCESS_TOKEN=
MP_USER_ID=
MP_EXTERNAL_POS_ID=
# Sucursal de la cuenta MP; cada usuario Privy obtiene una caja propia.
MP_STORE_ID=
MP_WEBHOOK_SECRET=
CONVERSION_FEE_BPS=50
ETH_RPC_URL=
# Antigüedad máxima de la cotización Chainlink USD/ARS, en segundos.
# 90000 = 25 horas (heartbeat publicado de 24 h + 1 h de margen).
CHAINLINK_MAX_AGE_SECONDS=90000
# RPC de Arc para las Functions (server-side). Puede llevar API key de un proveedor.
ARC_RPC=https://rpc.mainnet.arc.io
PAYMENTS_BASE_URL=
INTERNAL_WORKER_SECRET=
PAYMENTS_ENABLED=false
# Administrators: comma-separated Privy user IDs. Private, never VITE_.
PAYMENTS_ADMIN_USER_IDS=

# Envíos USDC: el usuario paga el fee de red de Arc en USDC. Habilitar después de validar la wallet.
TRANSFERS_ENABLED=false
# Optional production pilot: exact Privy user IDs, comma-separated. Empty denies all while disabled.
TRANSFERS_ALLOWED_USER_IDS=
